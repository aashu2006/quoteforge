# --- Agent (agent/) ---
# Model provider for the agent: openai | truefoundry
MODEL_PROVIDER=openai

# OpenAI (used when MODEL_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-5.5

# TrueFoundry AI Gateway (used when MODEL_PROVIDER=truefoundry)
# OpenAI-compatible base URL; TrueForge appends /chat/completions
TFY_GATEWAY_BASE_URL=
TFY_API_KEY=
# Gateway model id, e.g. anthropic/claude-sonnet-...
TFY_MODEL_ID=

# TrueForge server started with `npx @truefoundry/trueforge`
TRUEFORGE_BASE_URL=http://localhost:8790

# MCP server exposing the shop tools. Mock server by default; swap for the real tools server.
TOOLS_MCP_URL=http://127.0.0.1:8801/mcp

# Optional. When set, the agent's TrueForge sandbox is enabled (Daytona).
DAYTONA_API_KEY=

# Costing skill (sandbox/) is cloned from git into the sandbox. Pin SKILL_REF to a tag for demos.
SKILL_REPO_URL=https://github.com/aashu2006/quoteforge
SKILL_REF=main

# --- Shop DB (db/, tools/) ---
# Local dummy credentials; pick your own password.
POSTGRES_USER=quoteforge
POSTGRES_PASSWORD=
POSTGRES_DB=quoteforge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
